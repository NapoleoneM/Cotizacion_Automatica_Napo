# Copie este archivo como .env en el servidor (NO se sube a git) y ponga los
# valores reales. El .env queda junto al docker-compose.yml.
#
#   cp .env.example .env
#   nano .env
#

# PIN de acceso del equipo (obligatorio: sin esto, docker compose up falla).
APP_PIN=0000

# PIN aparte de la jefa de ventas (opcional). Sin esto, no existe el rol
# jefa: nadie ve "Gestión" y todos entran como asesor con APP_PIN.
APP_PIN_JEFA=

# Token del puente para la Torre de Control (opcional). Sin esto,
# /api/torre/historial responde 503.
TORRE_TOKEN=
